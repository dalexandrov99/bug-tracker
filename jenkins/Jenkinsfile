pipeline {
    agent any

    stages {
        stage('Unit Tests - Backend') {
            agent {
                docker {
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-backend') {
                    sh 'mkdir -p .cache'
                    sh 'export GOCACHE=$(pwd)/.cache && go test -v ./...'

                }
            }
        }
    }
}
